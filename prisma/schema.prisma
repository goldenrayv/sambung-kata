generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String   @id @default(cuid())
  username                  String   @unique
  password                  String
  isSuperUser               Boolean  @default(false)
  isFirstTimePasswordChange Boolean  @default(false)
  expiresAt                 DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Word {
  id         String   @id @default(cuid())
  word       String   @unique
  isVerified String   @default("unverified") // "verified", "unverified", "rejected"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Postgres-managed:
  //   ALTER TABLE "Word" ADD COLUMN word_rev text GENERATED ALWAYS AS (reverse(word)) STORED;
  //   CHECK (word = UPPER(word))
  //   indexes word_prefix_idx, word_rev_idx (text_pattern_ops, partial on isActive)
  // Unsupported() makes Prisma aware of the column without exposing it on the client.
  word_rev   Unsupported("text")?

  @@index([isActive, isVerified, word])
}

model TacticalSuffix {
  id        String   @id @default(cuid())
  suffix    String   @unique
  tier      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


